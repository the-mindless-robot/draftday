{
  "manifest_version": 3,
  "name": "Draft Monster Sync",
  "version": "1.0",
  "description": "Syncs ESPN live auction draft picks to Draft Monster",
  "permissions": ["storage"],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Draft Monster Sync"
  },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
